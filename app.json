{
  "expo": {
    "name": "FILAS",
    "slug": "FILAS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo Adaptable.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Logo Adaptable.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "expo-splash-screen": {
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo Adaptable.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.isaiasgerard9999.FILAS"
    },
    "web": {
      "favicon": "./assets/Logo Adaptable.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "ac8657d1-9f2c-49d2-bc64-6c04a80478cf"
      }
    }
  }
}
